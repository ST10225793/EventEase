@model EventEase.Models.Venue

@{
    ViewData["Title"] = "Edit Venue";
}

<div class="form-card text-center col-md-8 mx-auto mt-4">
    <i class="bi bi-pencil-square" style="font-size: 3rem; color: #f06292;"></i>
    <h1 class="form-title">Refine the Magic</h1>
    <p class="form-subtitle">Updating the details for <strong>@Model.VenueName</strong> 🎀</p>

    <div class="row text-start justify-content-center">
        <div class="col-md-8">
            <form asp-action="Edit" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <input type="hidden" asp-for="VenueId" />

                @* IMPORTANT: We keep the old ImageURL hidden so it doesn't get lost if we don't upload a new one *@
                <input type="hidden" asp-for="ImageURL" />

                <div class="form-group mb-3">
                    <label asp-for="VenueName" class="control-label fw-bold" style="color: #880e4f;"></label>
                    <input asp-for="VenueName" class="form-control" />
                    <span asp-validation-for="VenueName" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Location" class="control-label fw-bold" style="color: #880e4f;"></label>
                    <input asp-for="Location" class="form-control" />
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Capacity" class="control-label fw-bold" style="color: #880e4f;"></label>
                    <input asp-for="Capacity" class="form-control" />
                    <span asp-validation-for="Capacity" class="text-danger"></span>
                </div>

                <div class="form-group mb-4">
                    <label class="control-label fw-bold" style="color: #880e4f;">Update Venue Photo</label>

                    @if (!string.IsNullOrEmpty(Model.ImageURL))
                    {
                        <div class="mb-2 text-center">
                            <small class="text-muted">Current Preview:</small><br />
                            <img src="@Model.ImageURL" class="rounded-3 shadow-sm mb-2" style="max-height: 120px; border: 2px solid #fce4ec;" />
                        </div>
                    }

                    <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                    <small class="text-muted">Leave empty to keep the current sparkly photo! ✨</small>
                    <span asp-validation-for="ImageFile" class="text-danger"></span>
                </div>

                <div class="form-group text-center">
                    <button type="submit" class="btn btn-pink w-100">
                        <i class="bi bi-check2-heart"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="mt-4 text-center">
        <a asp-action="Index" class="btn-back"><i class="bi bi-arrow-left-circle"></i> Back to Gallery</a>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}