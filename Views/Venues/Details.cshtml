@model EventEase.Models.Venue

@{
    ViewData["Title"] = "Venue Details";
}

<div class="form-card col-md-8 mx-auto mt-4 text-center">
    <div class="mb-4">
        <i class="bi bi-stars" style="font-size: 2.5rem; color: #f06292;"></i>
        <h1 class="form-title">@Model.VenueName</h1>
        <p class="form-subtitle">Exploring the magic of this location ✨</p>
    </div>

    <div class="venue-detail-image-wrapper mb-4">
        @if (!string.IsNullOrEmpty(Model.ImageURL))
        {
            <img src="@Model.ImageURL" alt="@Model.VenueName" class="venue-detail-img" />
        }
        else
        {
            <div class="venue-detail-placeholder">
                <i class="bi bi-camera" style="font-size: 4rem; color: #fce4ec;"></i>
                <p class="text-muted">No photo yet!</p>
            </div>
        }
    </div>

    <div class="row text-start mb-4">
        <div class="col-md-6 mb-3">
            <div class="p-3 rounded-4" style="background-color: #fff0f3; border: 1px dashed #f06292;">
                <h6 class="fw-bold" style="color: #880e4f;"><i class="bi bi-geo-alt-fill me-2"></i>Location</h6>
                <p class="mb-0">@Model.Location</p>
            </div>
        </div>
        <div class="col-md-6 mb-3">
            <div class="p-3 rounded-4" style="background-color: #fff0f3; border: 1px dashed #f06292;">
                <h6 class="fw-bold" style="color: #880e4f;"><i class="bi bi-people-fill me-2"></i>Guest Capacity</h6>
                <p class="mb-0">Up to @Model.Capacity lovely guests</p>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-center gap-3">
        <a asp-action="Edit" asp-route-id="@Model?.VenueId" class="btn btn-pink px-4">
            <i class="bi bi-pencil-heart"></i> Edit Venue
        </a>
        <a asp-action="Index" class="btn-back">
            <i class="bi bi-arrow-left-circle"></i> Back to Gallery
        </a>
    </div>
</div>

<style>
    /* Spotlight Image Styling */
    .venue-detail-image-wrapper {
        width: 100%;
        max-height: 400px;
        border-radius: 25px;
        overflow: hidden;
        border: 5px solid #fff;
        box-shadow: 0 10px 20px rgba(240, 98, 146, 0.15);
        background-color: #fffafb;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .venue-detail-img {
        width: 100%;
        height: auto;
        object-fit: cover;
    }

    .venue-detail-placeholder {
        padding: 50px;
        text-align: center;
    }
</style>