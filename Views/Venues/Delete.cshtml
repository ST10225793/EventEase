@model EventEase.Models.Venue

@{
    ViewData["Title"] = "Delete Venue";
}

<div class="form-card col-md-8 mx-auto mt-4 text-center border-danger-subtle">
    <div class="mb-4">
        <i class="bi bi-exclamation-octagon" style="font-size: 3rem; color: #dc3545;"></i>
        <h1 class="form-title" style="color: #dc3545;">Are you sure?</h1>
        <p class="form-subtitle">Deleting <strong>@Model.VenueName</strong> cannot be undone! </p>
    </div>

    <div class="p-4 rounded-4 mb-4" style="background-color: #fff5f5; border: 1px solid #f8d7da;">
        <div class="row align-items-center">
            <div class="col-md-4">
                @if (!string.IsNullOrEmpty(Model.ImageURL))
                {
                    <img src="@Model.ImageURL" alt="Venue" class="img-fluid rounded-3 shadow-sm" style="max-height: 120px;" />
                }
                else
                {
                    <div class="bg-white rounded-3 py-4 border">
                        <i class="bi bi-image text-muted" style="font-size: 2rem;"></i>
                    </div>
                }
            </div>
            <div class="col-md-8 text-start">
                <h5 class="fw-bold mb-1" style="color: #880e4f;">@Model.VenueName</h5>
                <p class="mb-1"><i class="bi bi-geo-alt me-2"></i>@Model.Location</p>
                <p class="mb-0"><i class="bi bi-people me-2"></i>Capacity: @Model.Capacity</p>
            </div>
        </div>
    </div>

    <div class="alert alert-warning rounded-4 border-0 mb-4" style="background-color: #fff3cd; color: #856404;">
        <i class="bi bi-info-circle-fill me-2"></i>
        If this venue is linked to an existing event, the deletion might fail to protect your data!
    </div>

    <form asp-action="Delete">
        <input type="hidden" asp-for="VenueId" />

        <div class="d-flex justify-content-center gap-3">
            <button type="submit" class="btn btn-danger px-4 rounded-pill">
                <i class="bi bi-trash3-fill me-2"></i>Yes, Delete Permanently
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">
                No, Keep it! 
            </a>
        </div>
    </form>
</div>

<style>
    /* Make the delete page look a bit more urgent while staying in the card theme */
    .border-danger-subtle {
        border: 2px solid #f8d7da !important;
    }

    .btn-danger {
        background-color: #d32f2f;
        border: none;
        transition: transform 0.2s;
    }

        .btn-danger:hover {
            background-color: #b71c1c;
            transform: scale(1.05);
        }
</style>