@{
    ViewData["Title"] = "Dashboard";
}
@model IEnumerable<EventEase.Models.Event>

<div class="dashboard-container">
    <div class="text-center mb-5">
        <div class="hello-kitty-float">
            <img src="~/images/hello-kitty.png" alt="Hello Kitty" style="width: 100%;" />
        </div>
        <h1 class="display-4 fw-bold" style="color: #880e4f;">🎀EventEase Dashboard🎀</h1>
        <p class="lead text-muted">Manage your venues and bookings with style.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card stat-card p-4 text-center">
                <i class="bi bi-house-heart-fill card-icon"></i>
                <h3 class="mt-3">Venues</h3>
                <p class="text-muted">Manage your locations</p>
                <a asp-controller="Venues" asp-action="Index" class="btn btn-pink">View All</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card stat-card p-4 text-center">
                <i class="bi bi-calendar-event card-icon"></i>
                <h3 class="mt-3">Events</h3>
                <p class="text-muted">Schedule your highlights</p>
                <a asp-controller="Events" asp-action="Index" class="btn btn-pink">View All</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card stat-card p-4 text-center">
                <i class="bi bi-ticket-perforated card-icon"></i>
                <h3 class="mt-3">Bookings</h3>
                <p class="text-muted">Track reservations</p>
                <a asp-controller="Bookings" asp-action="Index" class="btn btn-pink">Manage</a>
            </div>
        </div>
    </div>

    <div class="mt-5 p-5 text-white rounded shadow-sm" style="background: linear-gradient(45deg, #f06292, #fce4ec); color: #880e4f !important;">
        <h2>Ready to host?</h2>
        <p>Creating a seamless experience for your clients starts here.</p>
        <a asp-controller="Events" asp-action="Create" class="btn btn-outline-light mt-2" style="border-color: #880e4f; color: #880e4f;">Create New Event</a>
    </div>

    <div class="mt-5 p-4 rounded shadow-sm bg-white border-pink">
        <h3 style="color: #880e4f;"><i class="bi bi-calendar-heart"></i> Your Magical Schedule 🎀</h3>
        <hr style="border-color: #fce4ec;" />
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr style="color: #f06292;">
                        <th>Event</th>
                        <th>Date</th>
                        <th>Location</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.EventName</td>
                                <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                                <td>@(item.Venue?.VenueName ?? "No Venue Assigned")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted">No events scheduled yet. Time to create some magic! ✨</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>