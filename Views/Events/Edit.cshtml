@model EventEase.Models.Event

@{
    ViewData["Title"] = "Edit Event";
}

<div class="form-card text-center col-md-8 mx-auto mt-4">
    <i class="bi bi-pencil-square" style="font-size: 3rem; color: #f06292;"></i>
    <h1 class="form-title">Edit Event Details</h1>
    <p class="form-subtitle">Polishing the plans for <strong>@Model.EventName</strong> </p>

    <div class="row text-start justify-content-center">
        <div class="col-md-8">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <input type="hidden" asp-for="EventId" />

                <div class="form-group mb-3">
                    <label asp-for="EventName" class="control-label fw-bold" style="color: #880e4f;"></label>
                    <input asp-for="EventName" class="form-control" />
                    <span asp-validation-for="EventName" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="EventDate" class="control-label fw-bold" style="color: #880e4f;"></label>
                    <input asp-for="EventDate" class="form-control" type="datetime-local" />
                    <span asp-validation-for="EventDate" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Description" class="control-label fw-bold" style="color: #880e4f;"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="VenueId" class="control-label fw-bold" style="color: #880e4f;">Assigned Venue</label>
                    <select asp-for="VenueId" class="form-control" asp-items="ViewBag.VenueId">
                        <option value="">-- Select a Venue --</option>
                    </select>
                    <span asp-validation-for="VenueId" class="text-danger"></span>
                </div>

                <div class="form-group text-center">
                    <button type="submit" class="btn btn-pink w-100">
                        <i class="bi bi-check2-heart"></i> Update Event 
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="mt-4 text-center">
        <a asp-action="Index" class="btn-back">
            <i class="bi bi-arrow-left-circle"></i> Back to Schedule
        </a>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}