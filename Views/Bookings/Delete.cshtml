@model EventEase.Models.Booking

@{
    ViewData["Title"] = "Delete Booking";
}

<div class="form-card col-md-8 mx-auto mt-4 text-center border-danger-subtle">
    <div class="mb-4">
        <i class="bi bi-trash3" style="font-size: 3rem; color: #dc3545;"></i>
        <h1 class="form-title" style="color: #dc3545;">Cancel this Booking?</h1>
        <p class="form-subtitle">Are you sure you want to remove the booking for <strong>@Model.CustomerName</strong>? </p>
    </div>

    <div class="p-4 rounded-4 mb-4" style="background-color: #fff5f5; border: 1px solid #f8d7da;">
        <div class="row align-items-center">
            <div class="col-md-2 text-center">
                <i class="bi bi-person-x-fill" style="font-size: 2.5rem; color: #880e4f;"></i>
            </div>
            <div class="col-md-10 text-start">
                <h5 class="fw-bold mb-1" style="color: #880e4f;">@Model.CustomerName</h5>
                <div class="d-flex flex-column gap-1 small text-muted">
                    <span><i class="bi bi-stars me-2"></i>Event: @(Model.Event?.EventName ?? "Sparkly Event")</span>
                    <span><i class="bi bi-geo-alt me-2"></i>Venue: @(Model.Venue?.VenueName ?? "Dream Location")</span>
                    <span><i class="bi bi-calendar-x me-2"></i>Date: @Model.BookingDate.ToString("dd MMM yyyy")</span>
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-warning rounded-4 border-0 mb-4" style="background-color: #fff3cd; color: #856404; font-size: 0.9rem;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        Warning: This action will permanently remove this booking from the system!
    </div>

    <form asp-action="Delete">
        <input type="hidden" asp-for="BookingId" />

        <div class="d-flex justify-content-center gap-3">
            <button type="submit" class="btn btn-danger px-4 rounded-pill">
                <i class="bi bi-trash3-fill me-2"></i>Yes, Delete Booking
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">
                No, Keep it! 
            </a>
        </div>
    </form>
</div>

<style>
    /* Consistent styling with your other Delete pages */
    .border-danger-subtle {
        border: 2px solid #f8d7da !important;
    }

    .btn-danger {
        background-color: #d32f2f;
        border: none;
        transition: transform 0.2s;
    }

        .btn-danger:hover {
            background-color: #b71c1c;
            transform: scale(1.05);
        }
</style>