@model EventEase.Models.Booking

@{
    ViewData["Title"] = "Booking Details";
}

<div class="form-card col-md-8 mx-auto mt-4 text-center">
    <div class="mb-4">
        <i class="bi bi-journal-check" style="font-size: 3rem; color: #f06292;"></i>
        <h1 class="form-title">Booking Confirmation</h1>
        <p class="form-subtitle">Reviewing the plans for <strong>@Model.CustomerName</strong> 🎀</p>
    </div>

    <hr style="border-top: 2px dashed #fce4ec;" />

    <div class="row text-start mt-4">
        <div class="col-12 mb-3">
            <div class="p-3 rounded-4" style="background-color: #fff0f3; border: 1px solid #fce4ec;">
                <h6 class="fw-bold" style="color: #880e4f;"><i class="bi bi-person-heart me-2"></i>Customer Name</h6>
                <p class="mb-0 fs-5">@Model.CustomerName</p>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="p-3 rounded-4 shadow-sm h-100" style="background-color: #fffafb; border-left: 5px solid #f06292;">
                <h6 class="fw-bold" style="color: #880e4f;"><i class="bi bi-stars me-2"></i>Event</h6>
                <p class="mb-0">@(Model.Event?.EventName ?? "Sparkly Event")</p>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="p-3 rounded-4 shadow-sm h-100" style="background-color: #fffafb; border-left: 5px solid #f06292;">
                <h6 class="fw-bold" style="color: #880e4f;"><i class="bi bi-geo-alt-fill me-2"></i>Venue</h6>
                <p class="mb-0">@(Model.Venue?.VenueName ?? "Dream Location")</p>
            </div>
        </div>

        <div class="col-12 mb-4">
            <div class="p-3 rounded-4 text-center" style="background-color: #fce4ec; border: 1px dashed #f06292;">
                <h6 class="fw-bold" style="color: #880e4f;"><i class="bi bi-calendar-check me-2"></i>Scheduled Date</h6>
                <p class="mb-0 fs-4 fw-bold" style="color: #d81b60;">
                    @Model.BookingDate.ToString("dddd, dd MMMM yyyy")
                </p>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-center gap-3">
        <a asp-action="Edit" asp-route-id="@Model?.BookingId" class="btn btn-pink px-4">
            <i class="bi bi-pencil-heart"></i> Edit Booking
        </a>
        <a asp-action="Index" class="btn-back">
            <i class="bi bi-arrow-left-circle"></i> Back to Management
        </a>
    </div>
</div>

<style>
    .fs-5 {
        font-size: 1.25rem;
    }

    .fs-4 {
        font-size: 1.5rem;
    }
</style>